ServerAliveInterval 60


Match exec "uname -s | grep -q Darwin"
	Include ~/.ssh/config.mac


Match exec "uname -s | grep -q Linux"
	Include ~/.ssh/config.linux

# jumphost to connect through for home network
Host tailscale
  HostName 100.92.157.19
  User root

Host loomy-development-*
	StrictHostKeyChecking accept-new

Host loomy-production-*
	StrictHostKeyChecking accept-new

# All localdomain hosts
Host *.localdomain
	StrictHostKeyChecking accept-new
	# ProxyJump tailscale
	ForwardAgent yes

# Nanocluster hosts
Host nc*.localdomain
    StrictHostKeyChecking off
    User pi
    IdentityAgent none
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_rsa

Host nerves*.local
     StrictHostKeyChecking off

Host 172.31.50.53
    StrictHostKeyChecking off
