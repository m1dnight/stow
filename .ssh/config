ServerAliveInterval 60


Match exec "uname -s | grep -q Darwin"
	Include ~/.ssh/config.mac


Match exec "uname -s | grep -q Linux"
	Include ~/.ssh/config.linux


Host loomy-development-*
	StrictHostKeyChecking accept-new

Host loomy-production-*
	StrictHostKeyChecking accept-new

Host *.localdomain
	StrictHostKeyChecking accept-new
